# ===== Backend Environment Variables =====

# Database Configuration
DB_USER=postgres
DB_PASSWORD=lalisa
DB_NAME=RBSSS
DB_NAME_TEST=RBSSS_test
DB_NAME_PROD=RBSSS_prod  # Separate DB for production
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=30d

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=emailpassword
EMAIL_FROM=no-reply@seweragesystem.com

# SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Map Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_token

#File config
PLOAD_PATH=./public/uploads
MAX_FILE_UPLOAD=1000000
FILE_UPLOAD_FORMATS=image/jpeg,image/png